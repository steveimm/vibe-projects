# Copy to .closepaw-local.env and edit for your machines. This file is safe to commit;
# .closepaw-local.env is ignored and may contain private hostnames or Tailscale IPs.

# SSH target used by scripts/remote/*.sh and /autotune remote eval snippets.
CLOSEPAW_REMOTE="user@desktop"
CLOSEPAW_REMOTE_DIR="~/path/to/closepaw"

# Host that the remote eval worker can SSH to for the local OpenAI-compatible proxy.
CLOSEPAW_PROXY_HOST="proxy-host-or-tailnet-ip"
CLOSEPAW_PROXY_USER="user"
CLOSEPAW_PROXY_PORT="18080"
