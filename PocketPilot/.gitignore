# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
/release/

# Gradle files
.gradle/
build/

# Gradle wrapper jar should be committed
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files — never commit. Keep real signing material outside the repo;
# these patterns are belt-and-suspenders against accidental in-tree copies.
*.jks
*.keystore
*.password

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# macOS
.DS_Store

# Backup files
*~
*.swp
*.bak

# Kotlin
.kotlin/

# env config
.env

# python
__pycache__/

# project specific
inspection_tool/debug_data
debug-output
.reference/
plan/progress.json*
.multmux
# QA / debug screenshots — never commit binary evidence under projects/
plan/**/*.png
plan/**/*.jpg
plan/**/*.jpeg
plan/**/*.webp
plan/**/*.gif
plan/**/*.mp4
# QA uiautomator dumps + visible-text snapshots — useless without their .png pair
plan/**/qa_screens*/**/*.xml
plan/**/qa_screens*/**/*_visible.txt
plan/**/diag_*/**/*.xml
# Runtime locks
.claude/scheduled_tasks.lock
plan/.tasks.json.lock
# Worktrees
.worktrees/

# Generated by copyClosePawBridge Gradle task
app/src/main/res/raw/closepaw_bridge_py

# Node / Next.js (marketing/ uses Next.js + bun for screenshot editor)
node_modules/
.next/

# Local working/preview directories
.design-preview/
.playwright-mcp/

# Exported screenshots — canonical copies live in doc/release/play-store/
export/

# One-time third-party Claude skills (install via /plugin if needed again)
.claude/skills/app-store-screenshots/
.claude/skills/app-store-screenshots-spec/
.claude/skills/nano-banana-aso/

# Local project artifacts and private agent working state.
# (No trailing slash so the patterns also match the symlinks themselves.)
plan
.claude/projects
.closepaw-local.env

# Personal IDE config
.vscode/
