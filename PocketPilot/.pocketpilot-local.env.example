# Copy to .pocketpilot-local.env and edit for your machines. This file is safe to commit;
# .pocketpilot-local.env is ignored and may contain private hostnames or Tailscale IPs.

# SSH target used by scripts/remote/*.sh and /autotune remote eval snippets.
POCKETPILOT_REMOTE="user@desktop"
POCKETPILOT_REMOTE_DIR="~/path/to/pocketpilot"

# Host that the remote eval worker can SSH to for the local OpenAI-compatible proxy.
POCKETPILOT_PROXY_HOST="proxy-host-or-tailnet-ip"
POCKETPILOT_PROXY_USER="user"
POCKETPILOT_PROXY_PORT="18080"
