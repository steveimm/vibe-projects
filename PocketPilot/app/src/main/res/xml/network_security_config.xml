<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Custom server addresses are user-configured, so they cannot be listed at build time. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">openai.com</domain>
        <domain includeSubdomains="true">chatgpt.com</domain>
        <domain includeSubdomains="true">openrouter.ai</domain>
    </domain-config>
</network-security-config>
